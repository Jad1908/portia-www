# Where an early-access submission goes.
#
# `functions/api/early-access.ts` checks these in order and uses the first that
# is fully configured. With none of them set the endpoint returns 503 and the
# form says so — on purpose. A form that accepts a submission and drops it is a
# control that lies, and this is the wrong page for one.
#
# Locally these go in `.dev.vars` (wrangler reads that, not `.env`). In
# production they go in the Cloudflare Pages project under
# Settings → Environment variables.

# --- Option 1: forward the JSON anywhere that accepts a POST ---------------
# A Zapier/Make hook, a Google Apps Script, an Airtable automation, your own
# endpoint. It receives { email, context, at, country }.
EARLY_ACCESS_WEBHOOK_URL=

# --- Option 2: send it as an email instead --------------------------------
# All three are required together. `EARLY_ACCESS_FROM` must be on a domain
# verified in Resend; the submitted address is set as reply-to, so replying to
# the notification replies to the person.
RESEND_API_KEY=
EARLY_ACCESS_TO=
EARLY_ACCESS_FROM=

# --- The site's own URL ----------------------------------------------------
# Feeds canonical and OG URLs at build time. There is no domain yet, so this is
# unset and the build falls back to http://localhost:4321.
SITE_URL=
