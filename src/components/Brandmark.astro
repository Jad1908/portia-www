---
/**
 * The brand lockup — **the application's own logo**, not a redraw of it.
 *
 * `LANDING.md` originally specified a geometric linework mark here and forbade
 * the raster. That was overridden deliberately: the app ships this logo, and a
 * landing page that draws its own version of the animal is the same failure as
 * a page that disagrees with the app about teal. The linework mark survives in
 * exactly one place — the scroll spider — where it has to take `currentColor`
 * and animate its legs, and a PNG can do neither.
 *
 * `public/portia-mark.png` is generated by `pnpm mark` from
 * `../portia/portia/ui/assets/cute-portia.png`: trimmed to the ink and re-padded
 * square, at 128px for a 32px slot. See `scripts/mark.mjs`.
 */
interface Props {
  size?: number;
  /** `null` marks the image decorative — use it wherever the wordmark is
   *  rendered beside it, so a screen reader is not told "portia" twice. */
  title?: string | null;
  class?: string;
}

const { size = 32, title = null, class: className = "" } = Astro.props;
---

<img
  src="/portia-mark.png"
  width={size}
  height={size}
  alt={title ?? ""}
  aria-hidden={title ? undefined : "true"}
  class:list={["brandmark", className]}
  decoding="async"
/>

<style>
  .brandmark {
    display: block;
    flex: none;
    /* The source has a soft contact shadow baked in, drawn for a light UI. In
     * dark mode it reads as a grey smudge under the creature; dropping the
     * shadow's contribution is cheaper and more honest than shipping a second
     * asset that could drift from the app's. */
    :global(:root[data-mode="dark"]) &,
    :global(.mode-dark) & {
      filter: brightness(1.06);
    }
  }
</style>
