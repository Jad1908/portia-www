---
/**
 * `code-block` — spec YAML, compiled SQL, a tool result.
 *
 * Flat, per DESIGN.md: "Code and data surfaces are flat." No gradient, no
 * traffic-light chrome, and **no syntax highlighting** — the app has none in
 * V0, and a page whose whole argument is that two surfaces must not disagree
 * should not colour the same file differently from the window that shows it.
 * Mono and restraint carry it.
 */
interface Props {
  /** The file this came from. Mono caption above the block; a code sample with
   *  no path is the un-citable number's cousin. */
  file?: string;
  lang?: string;
}
const { file, lang } = Astro.props;
---

<figure class="code">
  {
    file && (
      <figcaption class="code__file">
        <span>{file}</span>
        {lang && <span class="code__lang">{lang}</span>}
      </figcaption>
    )
  }
  <div class="code-block">
    <pre><slot /></pre>
  </div>
</figure>

<style>
  .code {
    margin: 0;
    min-width: 0;
  }
  .code__file {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    color: var(--portia-mute);
    margin-bottom: var(--spacing-sm);
  }
  .code__lang {
    color: var(--portia-ash);
  }
</style>
