---
/**
 * The three formations, drawn as linework.
 *
 * **This is no longer on the landing page.** The "How it works" columns used to
 * carry one of these each; they now carry a single point swarm that settles
 * into all three in turn (`islands/PrincipleSwarm.tsx`). What survives here is
 * the proof sheet at `/icons`, which is where the geometry gets eyeballed at
 * 3.5× before it is trusted in the swarm — a cloud of 720 dots hides a bad
 * coordinate that a 1.1px stroke shows immediately.
 *
 * The geometry itself lives in `~/lib/formations`, shared with the swarm, and
 * the reasoning behind every coordinate is in that file's header.
 *
 * **They draw themselves in.** Every shape carries `pathLength="1"`, which
 * normalises its geometry to a unit length whatever it actually measures — so
 * one `stroke-dasharray: 1; stroke-dashoffset: 1 → 0` rule animates a rect, a
 * circle and a bezier identically, with no per-path length measured in JS.
 *
 * The box is `64` units drawn at `112px`, and the stroke is `1.1` so that the
 * rendered weight lands where the old 48-unit/56px box put it — the size buys
 * detail, never heft.
 */
import { FORMATIONS, shapePath, type FormationName } from "~/lib/formations";

interface Props {
  /** `formation` from `principles.yaml`. */
  name: FormationName;
}
const { name } = Astro.props;
---

<svg
  class="p-icon"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {FORMATIONS[name].map((s) => <path d={shapePath(s)} pathLength="1" />)}
</svg>
