---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import poster from "~/assets/film/launch-poster.jpg";

/**
 * The launch film. It is the first of the showcase's five views — the pill
 * reads *Watch the film*, and the other four are the captures. This file is
 * the inside of that one panel: the frame, the poster, the play control and
 * the few lines of script that run it. `AppShowcase.astro` owns the pill, the
 * rotation and the stage the frame sits on. LANDING.md → "The film" is the
 * spec.
 *
 * Three decisions to have in front of you before editing anything here:
 *
 *  - **It does not autoplay, muted or otherwise.** The film is cut on a music
 *    bed with no voiceover, so a muted loop would throw away the edit and keep
 *    the pictures. It plays once, with sound, on a click — which is also what
 *    lets it play with sound at all, since a browser will not start audio
 *    without a gesture. Under `prefers-reduced-motion` nothing is different:
 *    the poster is the resting state, and it is a designed one.
 *
 *  - **Nothing downloads until someone asks for it.** `preload="none"` and a
 *    poster the page already optimised. The 1080p file is 56 MB; a visitor who
 *    never presses play pays for a JPEG.
 *
 *  - **The file is not in this repo and not in `public/` at deploy.** Workers
 *    static assets cap a file at 25 MiB, so the encode is served from an R2
 *    bucket on its own hostname. `PUBLIC_FILM_BASE` names it at build time;
 *    locally it is unset, falls back to `/film`, and the dev server plays the
 *    gitignored copy in `public/film/` that `pnpm film` puts there.
 *
 * ## It lives inside a carousel, and the carousel yields to it
 *
 * The showcase rotates its views on a timer until a visitor picks one. A film
 * that rotates away mid-play would be the failure that pattern is known for,
 * so pressing play **selects the film's tab**, which is what stops the
 * rotation for good — the same thing clicking the pill does. And picking any
 * other tab pauses the film, so nothing keeps playing under a hidden panel.
 * `selects` is the id of the radio that stands for this view.
 *
 * ## The player is Media Chrome, and it is not an island
 *
 * The controls are Media Chrome's web components wrapped round the plain
 * `<video>`: no React, no hydration, only the five elements the bar uses
 * imported. What they buy over the browser's own controls is a click anywhere
 * on the picture to play and pause, keyboard shortcuts on the frame, and a bar
 * drawn in the page's own tokens — the time in mono like every other figure.
 *
 * Before the first play the bar is hidden and the teal control below is the
 * only one drawn. Without script the `<noscript>` rule hides that button, the
 * custom elements never upgrade, and the `controls` attribute in the markup
 * makes the native player the whole interface — so there is no state in which
 * a button is drawn that does nothing.
 *
 * ## The frame
 *
 * It fills whatever stage it is put on — the showcase's is 2:1 — and the film
 * is 16:9, so it is **letterboxed on the surface colour, never cropped**: a
 * crop would cut the film's own text cards. There is no bottom mask, because
 * the film has its own end card and a fade over a picture that moves reads as
 * a fault; and there is no shadow, because a frame in the flow of the page is
 * not a transient overlay. The play control hangs off the lower left, the
 * corner the captures' crops gather on, so the five views read as one
 * composition.
 */

interface Props {
  film: CollectionEntry<"film">;
  /** The id of the showcase radio that stands for this view. */
  selects: string;
}
const { film, selects } = Astro.props;

/** Where the encode lives. Set in the Cloudflare build environment to the R2
 *  bucket's hostname; unset locally, where `public/film/` stands in. */
const base = (import.meta.env.PUBLIC_FILM_BASE ?? "/film").replace(/\/$/, "");
const src = `${base}/${film.data.source}`;

/** The poster is a real frame of the film, run through the same optimiser the
 *  captures use. `poster` takes a URL, so it is resolved here rather than with
 *  `<Image>`. 1920 wide: the frame is 1160px at most, but a poster is shown on
 *  a retina display at 2× and it is the only thing most visitors will see. */
const posterImg = await getImage({ src: poster, width: 1920, format: "jpg" });
---

<div class="film" data-film data-film-selects={selects}>
  {/* `autohide` hides the bar and the cursor two seconds into playback, and
      only then: paused, the bar stays. */}
  <media-controller class="film__player" autohide="2" data-film-player>
    {/* `controls` is in the markup so the no-script case is a working player;
        the script removes it, so a scripted visitor only ever sees the bar. */}
    <video
      slot="media"
      class="film__video"
      preload="none"
      playsinline
      controls
      poster={posterImg.src}
      width="1920"
      height="1080"
      aria-label={film.data.title}
      data-film-video
    >
      <source src={src} type="video/mp4" />
    </video>

    <media-control-bar class="film__bar">
      <media-play-button></media-play-button>
      <media-time-display showduration></media-time-display>
      <media-time-range></media-time-range>
      <media-mute-button></media-mute-button>
      <media-fullscreen-button></media-fullscreen-button>
    </media-control-bar>
  </media-controller>

  <button class="btn btn--primary film__play" type="button" data-film-play>
    <svg
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M2.5 1.5v9l7.5-4.5z" />
    </svg>
    <span>{film.data.action}</span>
    {/* The running time. Mono, because it is a figure a human reads as data
        — and it is the film's own, not one the page chose. */}
    <span class="film__duration">{film.data.duration}</span>
  </button>
</div>

<noscript>
  <style>
    .film__play {
      display: none;
    }
  </style>
</noscript>

<script>
  // Only the elements the bar uses, not the whole library.
  import "media-chrome/dist/media-controller.js";
  import "media-chrome/dist/media-control-bar.js";
  import "media-chrome/dist/media-play-button.js";
  import "media-chrome/dist/media-time-display.js";
  import "media-chrome/dist/media-time-range.js";
  import "media-chrome/dist/media-mute-button.js";
  import "media-chrome/dist/media-fullscreen-button.js";

  document.querySelectorAll<HTMLElement>("[data-film]").forEach((film) => {
    const video = film.querySelector<HTMLVideoElement>("[data-film-video]");
    const play = film.querySelector<HTMLButtonElement>("[data-film-play]");
    const player = film.querySelector<HTMLElement>("[data-film-player]");
    if (!video || !play || !player) return;

    // Script is running, so Media Chrome's bar is the one that shows.
    video.removeAttribute("controls");

    // The showcase radio this panel belongs to. Checking it is what stops the
    // rotation, and it is how the film's own tab lights up when play is
    // pressed rather than the pill.
    const radio = document.getElementById(
      film.dataset.filmSelects ?? "",
    ) as HTMLInputElement | null;

    // Any start selects the film's tab — the teal control, a click on the
    // picture, the bar's own button or a key — so the rotation can never carry
    // a playing film away. Checking a radio from script fires no `change`, so
    // this does not trip the pause below.
    video.addEventListener("play", () => {
      if (radio) radio.checked = true;
      film.classList.add("is-playing");
    });

    play.addEventListener("click", () => {
      // A decode or network failure leaves the bar up, with its play button
      // as the retry.
      video.play().catch(() => {});
      // The controller is what holds the keyboard shortcuts.
      player.focus({ preventScroll: true });
    });

    // Another view was picked while the film was playing: stop it, so nothing
    // keeps sounding from a panel that is no longer visible.
    if (radio) {
      document.addEventListener("change", (e) => {
        const t = e.target;
        if (
          t instanceof HTMLInputElement &&
          t.name === radio.name &&
          t !== radio
        ) {
          video.pause();
        }
      });
    }
  });
</script>

<style>
  /* Fills the stage it is put on. The showcase's frame draws the hairline and
   * the radius; this only has to fill it and place the control. */
  .film {
    position: relative;
    height: 100%;
    background-color: var(--portia-surface);
  }

  /* ---- The player.
   *
   * Media Chrome is themed through its custom properties, and every one of
   * them is set from a token. The bar is a flat slab of `canvas-deep` over the
   * picture, not a scrim fading up from the bottom edge: the page has no
   * gradients, and a scrim is one. ---- */
  .film__player {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--portia-surface);
    cursor: pointer;

    --media-font-family: var(--font-mono);
    --media-font-size: var(--text-mono-caption);
    --media-primary-color: var(--portia-surface-elevated);
    --media-secondary-color: transparent;
    --media-text-color: var(--portia-surface-elevated);
    --media-icon-color: var(--portia-surface-elevated);
    --media-control-background: transparent;
    --media-control-hover-background: color-mix(
      in srgb,
      var(--portia-surface-elevated) 10%,
      transparent
    );
    --media-control-height: 20px;
    --media-control-padding: 10px;
    --media-range-track-height: 3px;
    --media-range-track-border-radius: 2px;
    --media-range-track-background: color-mix(
      in srgb,
      var(--portia-surface-elevated) 24%,
      transparent
    );
    --media-range-bar-color: var(--portia-surface-elevated);
    --media-range-thumb-width: 10px;
    --media-range-thumb-height: 10px;
    --media-range-thumb-background: var(--portia-surface-elevated);
    --media-range-thumb-box-shadow: none;
    --media-time-range-buffered-color: color-mix(
      in srgb,
      var(--portia-surface-elevated) 40%,
      transparent
    );
    --media-focus-box-shadow: inset 0 0 0 2px var(--portia-accent-primary);
  }

  /* Fullscreen fills a screen that is already 16:9 or close to it; whatever
   * band is left is the film's own black, not the page's surface. */
  .film__player[mediaisfullscreen] {
    --film-band: 0px;
    background-color: var(--portia-canvas-deep);
  }

  /* `contain`, never `cover`: a 16:9 film on a 2:1 stage is letterboxed on
   * the surface colour rather than losing its top and bottom. The poster
   * follows the same fit. */
  .film__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Inset off the picture's own edges, so it sits on the film and not across
   * the letterbox band. Hidden until the first play: before that the teal
   * control is the only one on the frame. */
  .film__bar {
    margin: 0 calc(var(--film-band, 0px) + 12px) 12px;
    padding: 2px 4px;
    gap: 2px;
    align-items: center;
    border-radius: var(--radius-md);
    background-color: color-mix(
      in srgb,
      var(--portia-canvas-deep) 72%,
      transparent
    );
  }
  .film__player:not([mediahasplayed]) .film__bar {
    display: none;
  }
  .film__bar media-time-display {
    padding-inline: 8px;
  }
  .film__bar media-time-range {
    flex: 1;
  }

  /* ---- The play control.
   *
   * The section's one primary action — `#the-app` had none before the film.
   * Lower left, on the corner the captures' crops gather on, and never
   * centred: the pill row above is the one centred thing on the page and it
   * stays that way. ---- */
  /* `--film-band` is the width of the fitted picture's side band, set by
   * whoever owns the stage, so the control sits on the picture and not
   * astride the band's edge. Zero on a stage that is already 16:9. */
  .film__play {
    position: absolute;
    left: calc(var(--film-band, 0px) + 20px);
    bottom: 20px;
    z-index: 1;
  }
  .film.is-playing .film__play {
    display: none;
  }

  .film__duration {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    line-height: 1;
    opacity: 0.72;
  }

  @media (max-width: 640px) {
    .film__play {
      left: calc(var(--film-band, 0px) + 12px);
      bottom: 12px;
    }
  }
</style>
