---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { APP_SHOTS } from "~/lib/appShots";

/**
 * The one place on this page that shows the product.
 *
 * LANDING.md said, twice and in bold, that there are no screenshots of the app
 * anywhere on the page. That is reversed for this section only, and the
 * reversal is recorded in LANDING.md → "The fourth build" rather than patched
 * in quietly. The short version: the rule was written against a *drawn* mockup
 * in the hero — a picture of a product that did not exist yet, sitting above
 * the argument and doing the arguing. This is the opposite of that on every
 * axis. It is unretouched capture, it is of software that runs, and it sits
 * **after** the three columns it demonstrates. The reading order is untouched:
 * the page still argues before it demonstrates.
 *
 * ## What it is
 *
 * Three views, one at a time, behind a row of pills. Each view is a full
 * capture of the app with one or two crops of it floating in front — the
 * arrangement is borrowed openly from Clay's product section, and three things
 * about it were changed on the way in:
 *
 *  - **No colour blob behind the frame.** Clay backs each screenshot with a
 *    large blurred wash tinted to match the selected pill. That is a gradient,
 *    a glow and an atmospheric background at once, and it is also colour
 *    carrying nothing but which tab you are on. The frame sits flat on canvas.
 *  - **The pills do not each get a colour.** Three hues across three tabs is
 *    the ranking this system forbids, performed on the row that names the
 *    product's three abilities. One accent, on the selected one, meaning
 *    *selected*.
 *  - **The fade is a mask, not a wash.** The capture is masked away at its
 *    bottom edge so it resolves into the page instead of ending on a hard
 *    line. Nothing is tinted and no fill is introduced — the same argument
 *    `Marquee.astro` already makes for its feathered edges.
 *
 * ## No island, and it did not need one
 *
 * CLAUDE.md caps this page at three React islands and says anything else
 * wanting to be one should first be asked whether it needs to be interactive.
 * A tab strip does — but it does not need script. Three radios in one group,
 * `:checked ~` at the panels, and the whole thing works with the page's zero
 * bytes of JS: keyboard arrows move between tabs for free because that is what
 * a radio group already does, and a visitor with JS off gets the full section.
 *
 * The `:nth-of-type` pairing below is what keeps that from being three
 * hand-written rules per state. **It assumes exactly three views**, which is
 * asserted at the foot of this frontmatter rather than left to be discovered
 * when a fourth is added and silently never selectable.
 */

interface Props {
  views: CollectionEntry<"showcase">[];
}
const { views } = Astro.props;

/** The tab CSS below pairs radio *n* with pill *n* and panel *n* by hand, for
 *  three. A fourth view would render and never be reachable, so it fails here
 *  instead — loudly, at build time, next to the assumption it breaks. */
if (views.length !== 3) {
  throw new Error(
    `AppShowcase is written for exactly three views; got ${views.length}. ` +
      `Add the matching :nth-of-type pair in its <style> before adding one.`,
  );
}

/** Every full capture is a 2:1-ish window grab. Pinning the frame to one ratio
 *  stops the panels resizing the page as they swap, and stops a card placement
 *  meaning a different thing on one view than on another. */
const FRAME_RATIO = "2 / 1";

/** The frame is 1160px at its widest and never spans the viewport, so the
 *  browser is told that rather than left to assume 100vw and fetch the 2320px
 *  candidate on every phone. */
const FRAME_SIZES = "(max-width: 1256px) calc(100vw - 48px), 1160px";
---

<div class="showcase" role="group" aria-label="Views of the portia app">
  {/* The radios come first and stay first: every rule below reaches forward
      from `:checked` with `~`, which can only see later siblings. */}
  {
    views.map((view, i) => (
      <input
        class="showcase__radio"
        type="radio"
        name="showcase"
        id={`showcase-${view.id}`}
        checked={i === 0}
      />
    ))
  }

  <div class="showcase__tabs reveal">
    {
      views.map((view) => (
        <label class="showcase__tab" for={`showcase-${view.id}`}>
          {view.data.tab}
        </label>
      ))
    }
  </div>

  <div class="showcase__panels">
    {
      views.map((view) => {
        const shot = APP_SHOTS[view.id];
        if (!shot) throw new Error(`No capture registered for "${view.id}".`);

        return (
          <figure class="showcase__panel">
            <figcaption class="t-lede showcase__lede">
              {view.data.lede}
            </figcaption>

            <div class="showcase__stage">
              <div class="showcase__frame">
                <Image
                  class="showcase__shot"
                  src={shot.full}
                  alt={view.data.altFull}
                  widths={[760, 1160, 1740, 2320]}
                  sizes={FRAME_SIZES}
                  loading="lazy"
                />
              </div>

              {shot.cards.map((card, c) => (
                <div
                  class="showcase__card"
                  style={[
                    card.place.left !== undefined &&
                      `left:${card.place.left}%`,
                    card.place.right !== undefined &&
                      `right:${card.place.right}%`,
                    `bottom:${card.place.bottom}%`,
                    `width:${card.place.width}%`,
                  ]
                    .filter(Boolean)
                    .join(";")}
                >
                  <Image
                    class="showcase__shot"
                    src={card.src}
                    alt={view.data.cards[c]?.alt ?? ""}
                    widths={[280, 560]}
                    sizes="280px"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </figure>
        );
      })
    }
  </div>
</div>

<style define:vars={{ frameRatio: FRAME_RATIO }}>
  /* ---- The radios. Off-screen but never `display:none`, because the whole
   * keyboard story is that they are still a focusable radio group. ---- */
  .showcase__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ---- The tab row.
   *
   * Pills at the page's interactive radius and the page's button type, so a
   * control here and a control anywhere else on the page are the same object.
   * Scrolls sideways below the tablet band rather than wrapping to two lines:
   * three pills stacked read as a menu, and the row is a row. ---- */
  .showcase__tabs {
    display: flex;
    gap: var(--spacing-sm);
    overflow-x: auto;
    scrollbar-width: none;
    /* The row's own overflow would clip a focus ring drawn just outside a
     * pill, so the box is given the ring's width back. */
    padding: 3px;
    margin: -3px;
  }
  .showcase__tabs::-webkit-scrollbar {
    display: none;
  }

  .showcase__tab {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: 20px;
    border: 1px solid var(--portia-hairline);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--portia-mute);
    font-size: var(--text-button);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.2px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 120ms linear, background-color 120ms linear,
      border-color 120ms linear;
  }
  .showcase__tab:hover {
    color: var(--portia-ink);
  }

  /* The selected pill takes the accent tint. It means **selected** and nothing
   * else: the three pills are one size, one weight and one type, and the tint
   * moves with the visitor rather than marking one view as the good one. This
   * is the same wash `text-input-focused` uses, which is one of the three
   * places DESIGN.md permits it. */
  .showcase__radio:nth-of-type(1):checked ~ .showcase__tabs .showcase__tab:nth-child(1),
  .showcase__radio:nth-of-type(2):checked ~ .showcase__tabs .showcase__tab:nth-child(2),
  .showcase__radio:nth-of-type(3):checked ~ .showcase__tabs .showcase__tab:nth-child(3) {
    background-color: var(--portia-accent-soft);
    border-color: transparent;
    color: var(--portia-accent-text);
  }

  /* The input is off-screen, so its focus ring has to be drawn on the pill that
   * stands in for it — otherwise tabbing into the row lands on nothing visible. */
  .showcase__radio:nth-of-type(1):focus-visible ~ .showcase__tabs .showcase__tab:nth-child(1),
  .showcase__radio:nth-of-type(2):focus-visible ~ .showcase__tabs .showcase__tab:nth-child(2),
  .showcase__radio:nth-of-type(3):focus-visible ~ .showcase__tabs .showcase__tab:nth-child(3) {
    outline: 2px solid var(--portia-accent-primary);
    outline-offset: 2px;
  }

  /* ---- The panels.
   *
   * All three occupy one grid cell, so the block is as tall as its tallest view
   * and swapping a tab never moves the page under the pointer. The inactive
   * ones take `visibility: hidden`, which is what keeps them out of the
   * accessibility tree and out of tab order — `opacity: 0` alone would leave
   * three captures announced on top of each other. ---- */
  .showcase__panels {
    display: grid;
    margin-top: var(--spacing-xxl);
  }
  .showcase__panel {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 420ms var(--ease-reveal), visibility 0s linear 420ms;
  }
  .showcase__radio:nth-of-type(1):checked ~ .showcase__panels .showcase__panel:nth-child(1),
  .showcase__radio:nth-of-type(2):checked ~ .showcase__panels .showcase__panel:nth-child(2),
  .showcase__radio:nth-of-type(3):checked ~ .showcase__panels .showcase__panel:nth-child(3) {
    opacity: 1;
    visibility: visible;
    transition: opacity 420ms var(--ease-reveal), visibility 0s;
  }

  .showcase__lede {
    max-width: 54ch;
    margin-bottom: var(--spacing-xxl);
  }

  /* ---- The stage. The frame plus whatever floats in front of it.
   *
   * `overflow: visible` is load-bearing: a card that hangs past the bottom edge
   * is the one thing in the composition that says *in front of* rather than
   * *pasted into*. The overhang is absorbed by the section's own padding. ---- */
  .showcase__stage {
    position: relative;
    aspect-ratio: var(--frameRatio);
  }

  .showcase__frame {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--portia-hairline);
    border-radius: var(--radius-md);
    background-color: var(--portia-surface);
    /* The capture resolves into the page rather than ending on a rule. A mask
     * is not a gradient in the sense the system forbids — nothing is tinted,
     * no fill is introduced, and what shows through is flat canvas. The same
     * argument `Marquee.astro` makes for its feathered edges. */
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
  }

  .showcase__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- The foreground crops.
   *
   * A 4px matte of the app's own elevated surface, then the hairline. The matte
   * is what makes the crop legible in both modes off one asset: in light it is
   * a white ring the hairline draws the edge of, in dark it is a dark ring that
   * separates a bright crop from a bright capture on its own. The shadow is
   * derived from `canvas-deep`, which is the same value in both modes, so it
   * never inverts into a white glow.
   *
   * This is a shadow on a page whose system says nothing lifts and nothing
   * floats. It is the app's own carve-out — *a transient overlay may carry one
   * soft shadow* — and these crops are literally that: an approval prompt, a
   * question waiting on an answer. Recorded in LANDING.md → "The fourth build". */
  .showcase__card {
    position: absolute;
    padding: 4px;
    border: 1px solid var(--portia-hairline-strong);
    border-radius: var(--radius-md);
    background-color: var(--portia-surface-elevated);
    box-shadow: 0 20px 44px -16px
      color-mix(in srgb, var(--portia-canvas-deep) 30%, transparent);
    overflow: hidden;
  }

  /* Under the tablet band the frame is small enough that a crop at 15–21% of it
   * is texture rather than a screen. It is dropped, not shrunk — the capture
   * behind it says the same thing more slowly, and half a legible pane beats
   * three illegible ones. */
  @media (max-width: 700px) {
    .showcase__card {
      display: none;
    }
  }

  /* The designed resting state is the selected panel, arrived. The global
   * reduced-motion block already collapses the cross-fade; this is here so the
   * fade is never mid-flight when a visitor who asked for no motion arrives. */
  @media (prefers-reduced-motion: reduce) {
    .showcase__panel {
      transition: none;
    }
  }
</style>
