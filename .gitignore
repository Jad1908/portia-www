# build output
dist/
.astro/

# dependencies
node_modules/
.pnpm-store/

# environment — where the early-access form's destination is configured.
# `.dev.vars` is the one wrangler reads locally, so it is the one that will
# actually hold a key; see .env.example for what goes in it.
.env
.dev.vars
!.env.example
# `.env.production` is committed on purpose: it holds `PUBLIC_FILM_BASE`, a
# public URL the build inlines. Nothing secret belongs in it — `PUBLIC_*` ships
# to every browser.


# the launch film — one 56 MB encode. `pnpm film` puts it here for the dev
# server to play; production serves it from R2 and `public/.assetsignore`
# keeps a deploy from trying to upload it.
# See LANDING.md → "The film".
public/film/

# deploy
.wrangler/
.vercel/

# macOS
.DS_Store

# editors
.idea/
*.swp

# scratch — throwaway mockups, palette experiments, spider iterations.
# Same role as portia's sandbox/: spin up as many as you like, none reach the repo.
sandbox/
