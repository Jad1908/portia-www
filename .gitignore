# build output
dist/
.astro/

# dependencies
node_modules/
.pnpm-store/

# environment — where the early-access form's destination is configured.
# `.dev.vars` is the one wrangler reads locally, so it is the one that will
# actually hold a key; see .env.example for what goes in it.
.env
.env.production
.dev.vars
!.env.example

# the launch film — two encodes, 56 MB and 17 MB. `pnpm film` puts them here
# for the dev server to play; production serves them from R2 and
# `public/.assetsignore` keeps a deploy from trying to upload them.
# See LANDING.md → "The film".
public/film/

# deploy
.wrangler/
.vercel/

# macOS
.DS_Store

# editors
.idea/
*.swp

# scratch — throwaway mockups, palette experiments, spider iterations.
# Same role as portia's sandbox/: spin up as many as you like, none reach the repo.
sandbox/
